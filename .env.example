# Optional build-time: public site URL used for canonicals, sitemap, share links.
VITE_SITE_URL=
# Optional build-time: Cloudflare Web Analytics token. Analytics script is omitted if unset.
VITE_CF_ANALYTICS_TOKEN=
# Optional build-time: tip/donation link. The support card is hidden if unset.
VITE_TIP_URL=
# Optional runtime (Cloudflare secrets / .dev.vars) — leaderboard is hidden if unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
